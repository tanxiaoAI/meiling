# ===== 应用配置 =====
HOST=0.0.0.0
PORT=1337
APP_KEYS=生成的密钥1,生成的密钥2,生成的密钥3,生成的密钥4
API_TOKEN_SALT=生成的salt
ADMIN_JWT_SECRET=生成的secret
TRANSFER_TOKEN_SALT=生成的salt
JWT_SECRET=生成的secret

# ===== 数据库配置 =====
# 由 Zeabur PostgreSQL 服务自动注入
DATABASE_CLIENT=postgres
DATABASE_URL=${POSTGRES_URL}
DATABASE_HOST=${POSTGRES_HOST}
DATABASE_PORT=${POSTGRES_PORT}
DATABASE_NAME=strapi_admin
DATABASE_USERNAME=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_SSL=false

# ===== 文件上传配置 =====
# 使用本地存储或配置 S3/R2
UPLOAD_PROVIDER=local
# UPLOAD_PROVIDER=aws-s3
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=
# AWS_BUCKET=

# ===== 邮件配置（可选） =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com

# ===== 其他配置 =====
NODE_ENV=production
