import { redirect } from "next/navigation";

import { AppShell } from "@/components/app-shell";
import { getSessionUser } from "@/lib/session";

export default async function AccountPage() {
  const user = await getSessionUser();

  if (!user) {
    redirect("/login");
  }

  return (
    <AppShell
      user={user}
      title="账号管理"
      description="查看当前登录状态、账号归属、租户信息，以及当前 MVP 的账号交付方式。"
    >
      <section className="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <article className="rounded-3xl border border-slate-200 p-5">
          <p className="text-sm text-slate-500">当前登录状态</p>
          <h3 className="mt-1 text-xl font-semibold">账号已登录，可直接使用门户能力</h3>
          <div className="mt-5 space-y-3 text-sm leading-6 text-slate-600">
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">显示名称</p>
              <p className="mt-1">{user.displayName}</p>
            </div>
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">登录账号</p>
              <p className="mt-1">{user.email}</p>
            </div>
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">账号角色</p>
              <p className="mt-1">{user.role === "operator" ? "运营管理员" : "客户账号"}</p>
            </div>
          </div>
        </article>

        <article className="rounded-3xl border border-slate-200 p-5">
          <p className="text-sm text-slate-500">账号归属</p>
          <h3 className="mt-1 text-xl font-semibold">当前账号绑定的租户与交付方式</h3>
          <div className="mt-5 space-y-3 text-sm leading-6 text-slate-600">
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">租户名称</p>
              <p className="mt-1">{user.tenantName}</p>
            </div>
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">租户编号</p>
              <p className="mt-1">{user.tenantId}</p>
            </div>
            <div className="rounded-2xl bg-slate-50 p-4">
              <p className="font-semibold text-slate-900">当前登录模式</p>
              <p className="mt-1">运营手动发号，门户登录前置，关闭在线注册与短信/邮箱验证。</p>
            </div>
          </div>
          <form action="/api/auth/logout" method="post" className="mt-5">
            <button
              type="submit"
              className="inline-flex items-center rounded-2xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:text-slate-900"
            >
              退出当前账号
            </button>
          </form>
        </article>
      </section>
    </AppShell>
  );
}
